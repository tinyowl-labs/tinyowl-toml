{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://tinyowl.dev/schemas/group.schema.json",
  "title": "Group Configuration",
  "description": "Schema for group.toml — project identity and shared defaults for a TinyOwl group.",
  "type": "object",
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "description": "Project identity metadata.",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Human-readable project name."
        },
        "description": {
          "type": "string",
          "description": "Optional longer description of the project."
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "object",
      "description": "Shared entity ID generation settings.",
      "properties": {
        "prefix": {
          "type": "string",
          "description": "Prefix prepended to generated entity IDs."
        },
        "include_year": {
          "type": "boolean",
          "default": true,
          "description": "Whether to include the current year in generated IDs."
        },
        "separator": {
          "type": "string",
          "default": "-",
          "description": "Separator character between ID components."
        },
        "pad_length": {
          "type": "integer",
          "minimum": 1,
          "default": 4,
          "description": "Zero-pad length for the numeric ID portion."
        },
        "start_at": {
          "type": "integer",
          "minimum": 1,
          "default": 1,
          "description": "Starting value for the numeric ID sequence."
        }
      },
      "additionalProperties": false
    },
    "srid": {
      "type": "object",
      "description": "Spatial reference system defaults.",
      "properties": {
        "default": {
          "type": "integer",
          "default": 4326,
          "description": "Default EPSG SRID for the project (4326 = WGS 84)."
        }
      },
      "additionalProperties": false
    },
    "vocabularies": {
      "type": "object",
      "description": "Vocabulary UUID references. Use additionalProperties to add custom vocabularies.",
      "properties": {
        "periodisation": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the periodisation vocabulary."
        },
        "find_material": {
          "type": "string",
          "format": "uuid",
          "description": "UUID of the find material vocabulary."
        }
      },
      "additionalProperties": {
        "type": "string",
        "format": "uuid"
      }
    },
    "import": {
      "type": "object",
      "description": "Import configuration defaults.",
      "properties": {
        "defaults": {
          "type": "object",
          "description": "Default settings applied to all imports.",
          "properties": {
            "date_type": {
              "type": "string",
              "default": "stratigraphic",
              "description": "Default date type for imported dates."
            },
            "classification_delimiter": {
              "type": "string",
              "default": ";",
              "description": "Default delimiter for multi-value classification columns."
            },
            "name_fallback_enabled": {
              "type": "boolean",
              "default": false,
              "description": "When true, fall back to source_id when name is empty."
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
