{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://tinyowl.dev/schemas/table.schema.json",
  "title": "Table Configuration",
  "description": "Schema for tables/{key}.toml — defines a GPKG feature table, its columns, and relations.",
  "type": "object",
  "required": ["table"],
  "properties": {
    "table": {
      "type": "object",
      "required": ["key", "label"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "class": { "type": "string" }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "object",
      "required": ["prefix"],
      "properties": {
        "prefix": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*$" }
      },
      "additionalProperties": false
    },
    "columns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "label"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "type": { "type": "string", "enum": ["id", "string", "integer", "double", "boolean", "date", "datetime", "arch_date", "enum", "media", "geometry"] },
          "label": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "description": { "type": "string" },
          "values": { "type": "array", "items": { "type": "string" } },
          "media": { "type": "string" },
          "vocabulary": { "type": "string" },
          "property": { "type": "string" },
          "range": { "type": "string" },
          "references": { "type": "string" },
          "unique": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "label", "target"],
        "properties": {
          "name": { "type": "string" },
          "label": { "type": "string", "minLength": 1 },
          "target": { "type": "string" },
          "description": { "type": "string" },
          "property": { "type": "string" },
          "unique": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
