{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://tinyowl.dev/schemas/type.schema.json",
  "title": "Entity Type Configuration",
  "description": "Schema for entity type config files — defines entity types, sub-types, properties, and import plans.",
  "type": "object",
  "required": ["version", "type"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version of this type configuration."
    },
    "type": {
      "type": "object",
      "description": "Core entity type definition.",
      "required": ["key"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Unique key identifier for this entity type (e.g. 'contexts', 'finds')."
        },
        "label": {
          "type": "string",
          "description": "Human-readable label for the entity type."
        },
        "description": {
          "type": "string",
          "description": "Longer description of what this entity type represents."
        }
      },
      "additionalProperties": false
    },
    "id": {
      "type": "object",
      "description": "Entity-type-specific ID generation overrides.",
      "properties": {
        "prefix": {
          "type": "string",
          "minLength": 1,
          "description": "ID prefix for this entity type (e.g. 'CTX', 'FND')."
        },
        "include_year": {
          "type": "boolean",
          "description": "Whether to include the current year in generated IDs."
        },
        "separator": {
          "type": "string",
          "description": "Separator character between ID components."
        },
        "pad_length": {
          "type": "integer",
          "minimum": 1,
          "description": "Zero-pad length for the numeric ID portion."
        },
        "start_at": {
          "type": "integer",
          "minimum": 1,
          "description": "Starting value for the numeric ID sequence."
        }
      },
      "additionalProperties": false
    },
    "requires": {
      "type": "object",
      "description": "Required fields for entities of this type.",
      "properties": {
        "name": {
          "type": "boolean",
          "description": "Whether a name/label is required."
        },
        "geometry": {
          "type": "boolean",
          "description": "Whether geometry is required."
        }
      },
      "additionalProperties": false
    },
    "properties": {
      "type": "object",
      "description": "Custom property definitions for this entity type.",
      "additionalProperties": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["string", "number", "boolean", "date"],
            "description": "Data type of the property."
          },
          "enum": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Allowed values for the property (if constrained)."
          }
        },
        "additionalProperties": false
      }
    },
    "sub_type": {
      "type": "object",
      "description": "Sub-type definitions that inherit and extend the parent type.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "description": "Human-readable label for the sub-type."
          },
          "description": {
            "type": "string",
            "description": "Description of the sub-type."
          },
          "requires": {
            "type": "object",
            "description": "Required fields for entities of this sub-type.",
            "properties": {
              "name": {
                "type": "boolean",
                "description": "Whether a name/label is required."
              },
              "geometry": {
                "type": "boolean",
                "description": "Whether geometry is required."
              }
            },
            "additionalProperties": false
          },
          "properties": {
            "type": "object",
            "description": "Custom property definitions for this sub-type.",
            "additionalProperties": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": ["string", "number", "boolean", "date"],
                  "description": "Data type of the property."
                },
                "enum": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "Allowed values for the property (if constrained)."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "classification": {
      "type": "object",
      "description": "Classification (vocabulary term) assignment settings.",
      "properties": {
        "vocabulary": {
          "type": "string",
          "description": "Vocabulary key to use for classification (e.g. 'periodisation')."
        },
        "mode": {
          "type": "string",
          "enum": ["column", "property"],
          "description": "How classifications are assigned: 'column' — from import column; 'property' — from entity property."
        }
      },
      "additionalProperties": false
    },
    "name": {
      "type": "object",
      "description": "Name generation template.",
      "properties": {
        "template": {
          "type": "string",
          "description": "Template string for auto-generated names. Supports {field} placeholders."
        }
      },
      "additionalProperties": false
    },
    "import": {
      "type": "object",
      "description": "Import plan definitions keyed by plan name (e.g. 'from_qgis').",
      "additionalProperties": {
        "type": "object",
        "description": "A named import plan.",
        "properties": {
          "description": {
            "type": "string",
            "description": "Human-readable description of this import plan."
          },
          "format": {
            "type": "string",
            "enum": ["csv", "geojson", "jsonl", "gpkg"],
            "description": "Source data format for this import."
          },
          "column": {
            "type": "object",
            "description": "Column mappings: source column name → target field.",
            "additionalProperties": {
              "type": "object",
              "required": ["target"],
              "properties": {
                "target": {
                  "type": "string",
                  "description": "Target entity field (source_id, name, geometry:wkt, geometry:lat, geometry:lng, classification, date:from, date:to, date:type, or a property key)."
                }
              },
              "additionalProperties": false
            }
          },
          "relation": {
            "type": "object",
            "description": "Relation extraction rules: rule name → relation config.",
            "additionalProperties": {
              "type": "object",
              "required": ["predicate", "source_column"],
              "properties": {
                "predicate": {
                  "type": "string",
                  "description": "Governed relation predicate (e.g. 'above', 'below', 'cuts', 'fills')."
                },
                "source_column": {
                  "type": "string",
                  "description": "Source column containing target entity source_ids."
                },
                "delimiter": {
                  "type": "string",
                  "default": ",",
                  "description": "Separator for multiple target source_ids in a single cell."
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "skos": {
      "type": "object",
      "description": "SKOS mapping configuration for vocabulary alignment.",
      "properties": {
        "concept_uri": {
          "type": "string",
          "format": "uri",
          "description": "URI of the SKOS concept this type maps to."
        },
        "mapping": {
          "type": "string",
          "enum": ["exactMatch", "closeMatch", "broadMatch", "narrowMatch", "relatedMatch"],
          "description": "SKOS mapping relationship type."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
