{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://tinyowl.dev/schemas/project.schema.json",
  "title": "Project Configuration",
  "description": "Schema for project.toml — project-level metadata, tags, dates, and ontology declarations.",
  "type": "object",
  "required": ["project"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "description": { "type": "string" },
        "machine": { "type": "string", "pattern": "^[a-z0-9]{3}$" },
        "tags": {
          "type": "object",
          "properties": {
            "manual": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "dates": {
          "type": "object",
          "properties": {
            "start_year": { "type": "integer" },
            "end_year": { "type": "integer" },
            "start_label": { "type": "string" },
            "end_label": { "type": "string" },
            "start_uri": { "type": "string" },
            "end_uri": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ontologies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["prefix", "name"],
        "properties": {
          "prefix": { "type": "string", "pattern": "^[a-z][a-z0-9]*$" },
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string" },
          "description": { "type": "string" },
          "endpoint": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      }
    },
    "predicates": {
      "type": "array",
      "description": "Optional registry of relation predicates (hints only; instance edges use free-string predicates in _relations).",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "inverse": { "type": "string", "minLength": 1 },
          "symmetric": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "graph": {
      "type": "object",
      "description": "Optional graph-view hints (predicate names for band membership/order).",
      "properties": {
        "bands": {
          "type": "object",
          "properties": {
            "membership": { "type": "string", "minLength": 1 },
            "order": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
